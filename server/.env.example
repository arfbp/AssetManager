# Copy to .env (never commit the real .env). Loaded via dotenv in src/config.ts.

# --- WebSocket / agent auth ---
# Bearer token agents present via the Authorization header (fallback auth path;
# prefer mTLS in production — see server/README.md).
OPTIFLEET_AGENT_AUTH_TOKEN=change-me

# HMAC secret used to sign commands sent to agents. Must exactly match the
# agent's OPTIFLEET_HMAC_SECRET (internal/config/config.go on the agent side).
OPTIFLEET_HMAC_SECRET=change-me-too

# TLS cert/key for the WSS listener the AGENTS connect to (production).
# Leave unset to run plain ws:// for local development only — server
# refuses to start in production mode without these set.
OPTIFLEET_TLS_CERT_PATH=
OPTIFLEET_TLS_KEY_PATH=

# TLS for the BROWSER-facing dashboard API + WebSocket (login, session
# tokens, every dispatched command). Defaults to reusing the pair above if
# left unset — set these only if the dashboard needs a different
# cert/domain than the agent hub (e.g. a public-facing Let's Encrypt cert
# vs. an internal one for agents). Leave both unset (and the pair above
# unset too) only for local http:// development — production refuses to
# start without this being configured one way or the other.
OPTIFLEET_HTTP_TLS_CERT_PATH=
OPTIFLEET_HTTP_TLS_KEY_PATH=

# --- Ports ---
OPTIFLEET_WS_PORT=8443
OPTIFLEET_HTTP_PORT=8080

# --- Dashboard (browser) auth ---
# Real per-user login (src/auth/) replaced the old single shared dashboard
# token — there's nothing to configure here anymore. Create accounts with:
#   npm run user:create -- <username> <password>
# Sessions are stored in Postgres (OPTIFLEET_DATABASE_URL below), so this
# requires the database to be set up first (npm run db:migrate).

# Origin(s) the browser dashboard is served from — comma-separated if more
# than one (e.g. a staging and a prod URL). Required for CORS: every REST
# call the dashboard makes carries a custom Authorization header, which
# makes it a CORS-preflighted request that the browser blocks client-side
# without this, regardless of method. Must match exactly what the browser's
# address bar shows (scheme + host + port) — no trailing slash, no wildcard.
OPTIFLEET_DASHBOARD_ORIGIN=http://localhost:3000

# --- LLM (Groq, OpenAI-compatible API) ---
# Free-tier key from https://console.groq.com/keys. src/llm/actionParser.ts
# and src/llm/remediationAdvisor.ts talk to Groq's OpenAI-compatible Chat
# Completions endpoint via the `openai` SDK with baseURL overridden — see
# server/README.md for why this swap is a drop-in replacement.
GROQ_API_KEY=

# --- Device groups config (scope resolution for NL commands) ---
OPTIFLEET_DEVICE_GROUPS_PATH=./config/device-groups.json

# --- Persistence (Postgres) ---
# Required — user accounts and sessions (src/auth/) live here, not in
# memory, alongside telemetry/command history. Run `npm run db:migrate` once
# after setting this, before starting the server — see src/db/schema.sql.
OPTIFLEET_DATABASE_URL=postgres://user:password@localhost:5432/optifleet

# --- Feature flags ---
# Mirrors the agent's own OPTIFLEET_ENABLE_RUN_SCRIPT gate — the server will
# refuse to ever dispatch a run_script command unless this is also "true"
# here, independent of the agent-side gate.
OPTIFLEET_ENABLE_RUN_SCRIPT_DISPATCH=false

# --- Outbound notifications (src/notifications/) ---
# Every channel below is independently optional — leave a channel's settings
# blank to skip it entirely; nothing is required. Fires on: a device-hang
# incident opening, a self-heal event (disk cleanup / service restart /
# memory leak), a device going offline or coming back online, and
# CPU/RAM alert-mode entering or clearing.

# Slack Incoming Webhook — https://api.slack.com/messaging/webhooks
OPTIFLEET_NOTIFY_SLACK_WEBHOOK=

# Microsoft Teams — a classic Office 365 Connector "Incoming Webhook" URL, OR
# a Power Automate "Workflows" HTTP-trigger URL (Microsoft has been retiring
# the former in favor of the latter — see src/notifications/channels/teams.ts
# for what payload shape to expect either way).
OPTIFLEET_NOTIFY_TEAMS_WEBHOOK=

# Email via plain SMTP (works with a company mail server, Gmail + app
# password, SendGrid/Mailgun's SMTP endpoints, ...). Leave HOST blank to
# disable; USER/PASS can be blank for an SMTP server that doesn't require auth.
OPTIFLEET_NOTIFY_EMAIL_HOST=
OPTIFLEET_NOTIFY_EMAIL_PORT=587
OPTIFLEET_NOTIFY_EMAIL_USER=
OPTIFLEET_NOTIFY_EMAIL_PASS=
OPTIFLEET_NOTIFY_EMAIL_FROM=OptiFleet AI <noreply@optifleet.local>
# Comma-separated recipient list.
OPTIFLEET_NOTIFY_EMAIL_TO=
