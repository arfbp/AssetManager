# คัดลอกไปเป็น .env (ห้าม commit .env จริง) โหลดผ่าน dotenv ใน src/config.ts

# --- WebSocket / auth ของเอเจนต์ ---
# bearer token ที่เอเจนต์แนบผ่าน header Authorization (เส้นทางสำรอง;
# แนะนำให้ใช้ mTLS ใน production — ดู server/README.md)
OPTIFLEET_AGENT_AUTH_TOKEN=change-me

# secret สำหรับ HMAC ใช้เซ็นคำสั่งที่ส่งไปยังเอเจนต์ ต้องตรงกับ
# OPTIFLEET_HMAC_SECRET ของเอเจนต์เป๊ะๆ (internal/config/config.go ฝั่งเอเจนต์)
OPTIFLEET_HMAC_SECRET=change-me-too

# TLS cert/key สำหรับ WSS listener ที่เอเจนต์เชื่อมต่อ (production)
# เว้นว่างไว้เพื่อรัน ws:// แบบไม่เข้ารหัสสำหรับพัฒนา local เท่านั้น —
# เซิร์ฟเวอร์จะปฏิเสธการสตาร์ทในโหมด production ถ้าไม่ได้ตั้งค่านี้
OPTIFLEET_TLS_CERT_PATH=
OPTIFLEET_TLS_KEY_PATH=

# TLS สำหรับ dashboard API + WebSocket ฝั่งเบราว์เซอร์ (ล็อกอิน, session
# token, ทุกคำสั่งที่ส่งออกไป) ค่าเริ่มต้นจะใช้คู่ด้านบนซ้ำถ้าไม่ได้ตั้งค่า
# ตั้งค่านี้เฉพาะถ้าแดชบอร์ดต้องใช้ cert/domain ต่างจาก agent hub (เช่น
# Let's Encrypt cert แบบ public เทียบกับ cert ภายในสำหรับเอเจนต์) เว้นว่าง
# ทั้งคู่นี้ (และคู่ด้านบนด้วย) ได้เฉพาะตอนพัฒนา local ด้วย http:// เท่านั้น
# — production จะปฏิเสธการสตาร์ทถ้าไม่ได้ตั้งค่านี้ทางใดทางหนึ่ง
OPTIFLEET_HTTP_TLS_CERT_PATH=
OPTIFLEET_HTTP_TLS_KEY_PATH=

# --- พอร์ต ---
OPTIFLEET_WS_PORT=8443
OPTIFLEET_HTTP_PORT=8080

# --- การยืนยันตัวตนแดชบอร์ด (เบราว์เซอร์) ---
# ระบบล็อกอินรายผู้ใช้จริง (src/auth/) แทนที่ dashboard token แบบ shared
# ตัวเดียวแบบเดิมแล้ว — ไม่มีอะไรให้ตั้งค่าตรงนี้อีกต่อไป สร้างบัญชีด้วย:
#   npm run user:create -- <username> <password>
# session เก็บใน Postgres (OPTIFLEET_DATABASE_URL ด้านล่าง) จึงต้องตั้งค่า
# database ก่อน (npm run db:migrate)

# origin ที่แดชบอร์ดฝั่งเบราว์เซอร์ให้บริการอยู่ — คั่นด้วย comma ถ้ามี
# มากกว่าหนึ่ง (เช่น staging กับ prod URL) จำเป็นสำหรับ CORS: ทุก REST call
# ที่แดชบอร์ดเรียกพก header Authorization แบบ custom มาด้วย ทำให้เป็น
# CORS-preflighted request ที่เบราว์เซอร์บล็อกฝั่ง client ถ้าไม่มีค่านี้
# ไม่ว่าจะใช้ method ไหน ต้องตรงกับที่แถบที่อยู่ของเบราว์เซอร์แสดงเป๊ะๆ
# (scheme + host + port) ไม่มี trailing slash ไม่ใช้ wildcard
OPTIFLEET_DASHBOARD_ORIGIN=http://localhost:3000

# --- LLM (Groq, API แบบเข้ากันได้กับ OpenAI) ---
# คีย์ฟรีจาก https://console.groq.com/keys src/llm/actionParser.ts และ
# src/llm/remediationAdvisor.ts คุยกับ Groq's Chat Completions endpoint ที่
# เข้ากันได้กับ OpenAI ผ่าน SDK `openai` โดย override baseURL — ดู
# server/README.md ว่าทำไมการสลับแบบนี้ใช้แทนกันได้ตรงๆ
GROQ_API_KEY=

# --- config กลุ่มอุปกรณ์ (ไล่หา scope สำหรับคำสั่งภาษาธรรมชาติ) ---
OPTIFLEET_DEVICE_GROUPS_PATH=./config/device-groups.json

# --- การเก็บข้อมูลถาวร (Postgres) ---
# จำเป็นต้องมี — บัญชีผู้ใช้และ session (src/auth/) เก็บที่นี่ ไม่ใช่ในหน่วย
# ความจำ พร้อมกับ telemetry/ประวัติคำสั่ง รัน `npm run db:migrate` ครั้งเดียว
# หลังตั้งค่านี้ ก่อนสตาร์ทเซิร์ฟเวอร์ — ดู src/db/schema.sql
OPTIFLEET_DATABASE_URL=postgres://user:password@localhost:5432/optifleet

# --- Feature flag ---
# สะท้อนประตู OPTIFLEET_ENABLE_RUN_SCRIPT ของเอเจนต์เอง — เซิร์ฟเวอร์จะ
# ปฏิเสธการส่งคำสั่ง run_script เสมอถ้าค่านี้ไม่เป็น "true" ด้วย แยกต่างหาก
# จากประตูฝั่งเอเจนต์
OPTIFLEET_ENABLE_RUN_SCRIPT_DISPATCH=false

# --- การแจ้งเตือนขาออก (src/notifications/) ---
# ทุกช่องทางด้านล่างเป็นตัวเลือกอิสระต่อกัน — เว้นค่าของช่องทางไหนว่างไว้ก็
# ข้ามได้เลย ไม่มีอะไรจำเป็นต้องตั้ง ทำงานเมื่อ: มี incident เครื่องค้างเปิดขึ้น,
# เหตุการณ์ self-heal (ลบไฟล์ / รีสตาร์ต service / memory leak), อุปกรณ์
# offline หรือกลับมา online, และเข้า/ออกโหมด alert ของ CPU/RAM

# Slack Incoming Webhook — https://api.slack.com/messaging/webhooks
OPTIFLEET_NOTIFY_SLACK_WEBHOOK=

# Microsoft Teams — URL "Incoming Webhook" ของ Office 365 Connector แบบเดิม
# หรือ URL HTTP-trigger ของ Power Automate "Workflows" (Microsoft กำลังเลิก
# ใช้แบบแรกไปใช้แบบหลัง — ดู src/notifications/channels/teams.ts ว่า
# payload แต่ละแบบหน้าตาเป็นอย่างไร)
OPTIFLEET_NOTIFY_TEAMS_WEBHOOK=

# อีเมลผ่าน SMTP ธรรมดา (ใช้ได้กับเมลเซิร์ฟเวอร์บริษัท, Gmail + app
# password, SMTP endpoint ของ SendGrid/Mailgun ฯลฯ) เว้น HOST ว่างไว้เพื่อ
# ปิดใช้งาน; USER/PASS เว้นว่างได้ถ้า SMTP server ไม่ต้องยืนยันตัวตน
OPTIFLEET_NOTIFY_EMAIL_HOST=
OPTIFLEET_NOTIFY_EMAIL_PORT=587
OPTIFLEET_NOTIFY_EMAIL_USER=
OPTIFLEET_NOTIFY_EMAIL_PASS=
OPTIFLEET_NOTIFY_EMAIL_FROM=OptiFleet AI <noreply@optifleet.local>
# รายชื่อผู้รับ คั่นด้วย comma
OPTIFLEET_NOTIFY_EMAIL_TO=
