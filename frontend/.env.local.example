# Copy to .env.local (never commit the real file). All of these are
# NEXT_PUBLIC_* — they end up in the browser bundle, so don't put anything
# here you wouldn't want a user of this dashboard to read out of devtools.

# Central Server REST API base URL (server/src/index.ts's Express app).
# Use https:// once the server has OPTIFLEET_HTTP_TLS_CERT_PATH/KEY_PATH
# (or the OPTIFLEET_TLS_* pair) configured — see server/.env.example. A
# self-signed cert means the browser needs a one-time manual trust: visit
# this URL directly once and accept the certificate warning before the
# dashboard's own fetch() calls to it will succeed.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Central Server WebSocket base URL — the dashboard connects to
# ${NEXT_PUBLIC_WS_URL}/ws/dashboard (server/src/ws/dashboardServer.ts).
# Use wss:// to match NEXT_PUBLIC_API_URL's http/https choice above.
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# No token to configure here anymore — real per-user login (src/lib/session.ts,
# server/src/auth/) replaced the old shared NEXT_PUBLIC_DASHBOARD_TOKEN.
# Create accounts on the server with `npm run user:create -- <username> <password>`.
